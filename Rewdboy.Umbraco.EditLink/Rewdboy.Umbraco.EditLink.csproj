<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<!-- net9.0 => Umbraco 16, net10.0 => Umbraco 17/18 -->
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>

		<PackageId>Rewdboy.Umbraco.EditLink</PackageId>
		<Version>2.2.1</Version>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<IncludeRazorContentInPack>true</IncludeRazorContentInPack>

		<!-- Packa Content som SDK redan inkluderar (wwwroot/**) -->
		<IncludeContentInPack>true</IncludeContentInPack>

		<Title>Edit link for quickly switch to edit mode in Umbraco</Title>
		<Description>A lightweight, non-intrusive package for Umbraco 16+ that adds a floating Edit Page button to the website frontend. Visible only to authenticated backoffice users, it opens the current page directly in edit mode. No client-side JavaScript, fully customizable via CSS.</Description>
		<Authors>Rodolphe Toots</Authors>
		<Company>Rewdboy Inc</Company>
		<!-- Taggen umbraco-marketplace krävs för att paketet ska listas på Umbraco Marketplace.
			 Kategori, ikon och skärmdumpar läses från umbraco-marketplace.json i repo-roten,
			 som Marketplace hämtar via PackageProjectUrl/RepositoryUrl. -->
		<PackageTags>umbraco;umbraco-marketplace</PackageTags>
		<PackageProjectUrl>https://github.com/rewdboy/Rewdboy.Umbraco.EditLink</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<RepositoryUrl>https://github.com/rewdboy/Rewdboy.Umbraco.EditLink</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<!-- Lägg .nupkg direkt i lokal NuGet-källa vid Release-build -->
		<PackageOutputPath Condition="'$(Configuration)' == 'Release'">D:\NuGetLocal</PackageOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<!-- Umbraco 16 (.NET 9) -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="[16.0.0, 17.0.0)" />
	</ItemGroup>

	<!-- Umbraco 17 och 18 (.NET 10) -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.0.0, 19.0.0)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="OpenIddict.Server.AspNetCore" Version="[6.0.0, 8.0.0)" PrivateAssets="all" />
		<!-- Added to address known vulnerabilities in transitive dependencies -->
		<PackageReference Include="MessagePack" Version="3.1.8" />
		<PackageReference Include="MailKit" Version="4.17.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<!-- Paketikon för NuGet/Marketplace (återanvänder exempelbilden tills en riktig ikon finns) -->
		<None Include="..\docs\images\editbutton_example.png" Pack="true" PackagePath="icon.png" />
		<None Include="..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	



</Project>
